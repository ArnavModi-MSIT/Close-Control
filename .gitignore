__pycache__/
*.pyc
.venv/
data/*
data_seed_*/

# Airflow's official docker-compose.yaml volume-mounts these onto the host --
# runtime state written by the containers (logs, generated airflow.cfg,
# plugin scans), not project code.
airflow/logs/
airflow/config/
airflow/plugins/

# Frontend build dependencies -- regenerated by `npm install`, never hand-edited.
node_modules/

# Frontend build output -- regenerated by `npm run build` (see CLAUDE.md's
# "How to run everything"), never hand-edited.
ui/review-queue-app/dist/

# Local Claude Code tooling state (lock files etc.), not project content.
.claude/

demo_video_script.md